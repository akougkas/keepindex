# Docker publishes both services on loopback by default. Change the application
# bind only when the host firewall restricts port 5173 to trusted LAN clients.
# SearXNG keeps its own loopback-only bind unless you deliberately override it.
KEEPINDEX_BIND_ADDRESS=127.0.0.1
KEEPINDEX_PORT=5173
KEEPINDEX_SEARXNG_BIND_ADDRESS=127.0.0.1
KEEPINDEX_SEARXNG_PORT=8888

# The Compose default reaches a local model server running on the Docker host.
# Native KeepIndex defaults to http://127.0.0.1:8080 instead.
LLM_URL=http://host.docker.internal:8080
# Optional Bearer token for an authenticated gateway on your private network.
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
# Local embedding model served by the same private OpenAI-compatible endpoint.
KEEPINDEX_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v2
KEEPINDEX_INFERENCE_PROVIDER=auto

# Canonical product configuration. The Compose stack sets the database and
# SearXNG paths internally, so ordinary Docker users can leave these blank.
KEEPINDEX_URL=http://localhost:5173
KEEPINDEX_ALLOWED_ORIGINS=
KEEPINDEX_BROWSER_HISTORY_PATHS=
KEEPINDEX_SEARCH_MAX_RETRIES=2
# Increase these only for large, trusted local corpora; indexed chunks are also
# held in application memory for low-latency retrieval.
KEEPINDEX_MAX_INDEXED_FILES=8000
KEEPINDEX_MAX_INDEXED_CHUNKS=80000
KEEPINDEX_CORPUS_MODEL=

# Native-only examples:
# KEEPINDEX_DB_PATH=server/keepindex.sqlite
# SEARXNG_URL=http://127.0.0.1:8888
