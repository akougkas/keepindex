# KeepIndex and SearXNG publish only on this computer's loopback interface.
KEEPINDEX_PORT=5173
KEEPINDEX_SEARXNG_PORT=8888
KEEPINDEX_URL=http://localhost:5173

# First-start AI connection. Docker reaches a local host runtime here.
# Settings can add/switch local runtimes, Blade, or other compatible endpoints.
# Native Bun installs instead use http://127.0.0.1:8080.
KEEPINDEX_AI_NAME=Local AI
LLM_URL=http://host.docker.internal:8080
KEEPINDEX_INFERENCE_PROVIDER=auto
LLM_MODEL=
# Optional Bearer credentials for this connection, including a remote gateway.
LLM_API_KEY=
# Optional alternate model at the SAME endpoint; no remote fallback.
LLM_FALLBACK_MODEL=
# Optional embedding model installed at that same OpenAI-compatible endpoint.
KEEPINDEX_EMBEDDING_MODEL=

# Only explicit additional LOOPBACK browser origins are supported for development.
KEEPINDEX_ALLOWED_ORIGINS=
# Semicolon-separated mounted History or places.sqlite files. Import is opt-in.
KEEPINDEX_BROWSER_HISTORY_PATHS=
KEEPINDEX_SEARCH_MAX_RETRIES=2
KEEPINDEX_MAX_INDEXED_FILES=8000
KEEPINDEX_MAX_INDEXED_CHUNKS=80000
KEEPINDEX_CORPUS_MODEL=

# Native-only examples (Compose sets these internally):
# KEEPINDEX_DB_PATH=server/keepindex.sqlite
# SEARXNG_URL=http://127.0.0.1:8888
