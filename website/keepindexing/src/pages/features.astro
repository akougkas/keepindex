---
import Layout from "@/layouts/BaseLayout.astro";
import ContentGuide from "@/components/Item/ContentGuide.astro";
const content = {
  eyebrow: "The product",
  title: "Find the thread in your own sources.",
  intro:
    "KeepIndex combines search, cited answers, and research in a personal workspace installed on your computer.",
  sections: [
    {
      id: "sources",
      title: "A useful index starts with your choices",
      paragraphs: [
        "Add a folder of notes, an Obsidian vault, local documents, or a code project. KeepIndex extracts readable text, chunks it, and ranks matches on this computer. Original files stay in place.",
        "PDF, DOCX, ODT, RTF, and EPUB extraction is included in the Docker image. Unsupported documents may contribute metadata only. Hidden folders and secret-like files are excluded by default; you still decide which folders are appropriate.",
      ],
      link: {
        href: "/docs#folders",
        label: "Grant your first folder",
      },
    },
    {
      id: "history",
      title: "Find a page you remember visiting",
      paragraphs: [
        "Choose individual Chrome, Edge, Brave, Chromium, or Firefox profiles before importing history. Search titles, URLs, visit counts, and timestamps alongside your other sources.",
        "The importer does not read passwords or cookies. Docker needs an explicit read-only profile mount. A page open in your browser cannot grant this access by itself.",
      ],
    },
    {
      id: "modes",
      title: "Search first. Ask when it helps.",
      paragraphs: [
        "Search returns ranked results you can inspect directly. Answer uses a bounded source pack and your selected model to produce a cited response. Research explores a topic through several questions before assembling a report.",
        "Citation identifiers and coverage are checked, with bounded repair for some errors. These checks help catch missing support; they do not prove an answer true. Follow the sources when accuracy matters.",
      ],
      link: {
        href: "/#demo",
        label: "Explore the sample workspace",
      },
    },
    {
      id: "web",
      title: "Include the web deliberately",
      paragraphs: [
        "A SearXNG container on your computer combines public search engine results. Use All to mix web and local sources, Web for web results, or a Files, Vaults, Docs, or History target for that local category.",
        "Web-enabled search terms reach external engines. Fetched pages make ordinary website requests. Local hosting of SearXNG does not make those interactions private from the destination.",
      ],
    },
    {
      id: "everyday",
      title: "A workspace that belongs here",
      paragraphs: [
        "Keep collections, sessions, search history, and evidence records on this computer. Install the local web app as a PWA in a supported browser, or keep it in a normal tab.",
        "The public product site has no account or private workspace. Remote access, phone pairing, and federation are deferred.",
      ],
      link: {
        href: "/docs",
        label: "Install KeepIndex",
      },
    },
  ],
};
---

<Layout title={content.title} description={content.intro}
  ><ContentGuide {...content} /></Layout
>
