---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Heading from "@/components/Typography/Heading.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import ContentProductHero from "@/components/Interactive/ContentProductHero.astro";
import ContentDemoLive from "@/components/Interactive/ContentDemoLive.astro";
import ContentTerminalCli from "@/components/Interactive/ContentTerminalCli.astro";
import ContentPrivacyMatrix from "@/components/Item/ContentPrivacyMatrix.astro";
---

<Layout
  title="Search your world. Keep it yours."
  description="Search your selected files, vaults, browser history, and the web with your choice of local or remote AI. Install KeepIndex locally. No hosted index or account."
>
  <ContentProductHero />
  <Section theme="light" paddingTop="large" paddingBottom="large" id="demo">
    <ContentWrapper variant="stack"
      ><Eyebrow>From scattered sources to something useful</Eyebrow><Heading
        tag="h2"
        variant="h1"
        maxWidth={22}>You already saved it.<br />Now find it again.</Heading
      ><Paragraph maxWidth={62} variant="large"
        >The note you wrote. The document you downloaded. The page you visited.
        Search them together, then ask your selected model to connect what the
        sources actually say.</Paragraph
      ></ContentWrapper
    >
    <ContentDemoLive />
  </Section>
  <Section paddingTop="large" paddingBottom="large">
    <ContentWrapper variant="columns"
      ><div>
        <Eyebrow>A deliberate boundary</Eyebrow><Heading
          tag="h2"
          variant="h1"
          maxWidth={19}>Your computer is the workspace.</Heading>
      </div><Fragment slot="column2"
        ><Paragraph variant="large"
          >KeepIndex runs beside your data. You choose the folders and browser
          profiles it can read. It builds an index there. AI runs locally by
          default; you can explicitly choose a remote gateway.</Paragraph
        ><Paragraph
          >Open the local app at localhost:5173. This public website never
          connects to that installation. A second device has its own workspace;
          pairing and federation are deferred.</Paragraph
        ><ButtonWrapper
          ><Button element="link" href="/architecture" emphasis="secondary"
            >See the architecture ↗</Button
          ></ButtonWrapper
        ></Fragment
      ></ContentWrapper
    >
    <ContentPrivacyMatrix />
    <Paragraph maxWidth={75}
      >Including the web sends your search terms to public engines. Files,
      Vaults, Docs, and History retrieve their local source category without web
      discovery. Local storage is protected by your computer’s security;
      KeepIndex does not encrypt its SQLite index.</Paragraph
    >
  </Section>
  <Section theme="brand" paddingTop="large" paddingBottom="large">
    <ContentWrapper variant="columns"
      ><div>
        <Eyebrow>Make it yours</Eyebrow><Heading
          tag="h2"
          variant="h1"
          maxWidth={18}>Start with one computer. And one folder.</Heading
        ><Paragraph
          >Install Docker, connect your preferred AI runtime, and grant your
          first folder. No account to create. No server to rent.</Paragraph
        ><ButtonWrapper
          ><Button element="link" href="/docs" emphasis="primary"
            >Follow the installation guide ↗</Button
          ><Button
            element="link"
            href="https://github.com/akougkas/keepindex"
            emphasis="secondary">Read the source ↗</Button
          ></ButtonWrapper>
      </div><Fragment slot="column2"><ContentTerminalCli /></Fragment
      ></ContentWrapper
    >
  </Section>
</Layout>
