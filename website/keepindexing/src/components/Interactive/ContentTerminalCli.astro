---
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Commands to display and copy. */
  code?: string;
  /** Visible title for the command block. */
  title?: string;
}
const {
  render = true,
  code = "git clone https://github.com/akougkas/keepindex.git\ncd keepindex\ncp .env.example .env\n# Configure your initial AI endpoint in .env\n./start.sh",
  title = "On your computer",
} = Astro.props;
---

{
  render && code && (
    <div class="terminal_wrap">
      <>
        <div class="terminal_top">
          <>
            <span>{title}</span>
            <button type="button" aria-label={`Copy commands: ${title}`}>
              Copy
            </button>
            <span class="terminal_status" role="status" aria-live="polite" />
          </>
        </div>
        <pre>
          <code>{code}</code>
        </pre>
      </>
    </div>
  )
}
<script>
  document.querySelectorAll<HTMLElement>(".terminal_wrap").forEach((root) => {
    root.querySelector("button")?.addEventListener("click", async () => {
      const status = root.querySelector<HTMLElement>('[role="status"]');
      try {
        await navigator.clipboard.writeText(
          root.querySelector("code")?.textContent ?? "",
        );
        if (status) status.textContent = "Copied";
      } catch {
        if (status) status.textContent = "Select the commands to copy them.";
      }
    });
  });
</script>
<style is:global>
  @layer components {
    .terminal_wrap {
      width: 100%;
      border: 0.0625rem solid #ffffff25;
      border-radius: 0.5rem;
      background: #091310;
      color: #f2efe6;
      overflow: hidden;
      .terminal_top {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1rem;
        border-bottom: 0.0625rem solid #ffffff20;
        color: #b4c1b5;
        font-size: 0.75rem;
      }
      button {
        margin-left: auto;
        color: #62d66b;
        cursor: pointer;
        padding: 0.3rem 0.6rem;
        border: 0.0625rem solid #62d66b44;
        border-radius: 0.2rem;
      }
      .terminal_status:empty {
        display: none;
      }
      pre {
        overflow-x: auto;
        padding: 1.5rem;
        font-size: 0.8rem;
        line-height: 1.9;
        tab-size: 2;
      }
      code {
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
      }
    }
  }
</style>
