---
import Heading from "@/components/Typography/Heading.astro";
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}
const { render = true } = Astro.props;
---

{
  render && (
    <div class="machine_wrap">
      <div class="machine_label">
        <span class="machine_indicator" />
        Your computer <span class="machine_status">One installation</span>
      </div>
      <div class="machine_sources">
        <div>
          <>
            <span>01</span>
            <strong>Folders & vaults</strong>
            <small>Only the paths you choose</small>
          </>
        </div>
        <div>
          <>
            <span>02</span>
            <strong>Browser history</strong>
            <small>Only the profiles you select</small>
          </>
        </div>
      </div>
      <div class="machine_connection" aria-hidden="true">
        ↓
      </div>
      <div class="machine_core">
        <>
          <span class="machine_monogram" aria-hidden="true">
            k/i
          </span>
          <div>
            <>
              <Heading tag="h3" variant="h4">
                KeepIndex
              </Heading>
              <p>Your index. Your results.</p>
            </>
          </div>
          <span class="machine_chip">localhost</span>
        </>
      </div>
      <div class="machine_services">
        <>
          <div>
            <>
              <strong>Your AI endpoint</strong>
              <small>Local by default · remote by choice</small>
            </>
          </div>
          <div>
            <>
              <strong>Local SearXNG</strong>
              <small>Web search when you include it</small>
            </>
          </div>
        </>
      </div>
      <div class="machine_edge">
        <>
          <span aria-hidden="true">↗</span>
          <p>
            Web searches contact public engines.
            <>
              <br />
              <strong>Remote AI receives evidence when selected.</strong>
            </>
          </p>
        </>
      </div>
    </div>
  )
}
<style is:global>
  @layer components {
    .machine_wrap {
      width: 100%;
      border: 0.0625rem solid #34443b;
      border-radius: 1rem;
      padding: 1.5rem;
      background: #0e1a19;
      color: #f2efe6;
      box-shadow: 0 2rem 5rem #0003;
      .machine_label {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        font-size: 0.8rem;
        margin-bottom: 2rem;
      }
      .machine_indicator {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 50%;
        background: #62d66b;
      }
      .machine_status {
        margin-left: auto;
        color: #a7b4ab;
        font-size: 0.7rem;
      }
      .machine_sources,
      .machine_services {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }
      .machine_sources > div {
        padding: 1rem;
        border: 0.0625rem solid #34443b;
        border-radius: 0.4rem;
      }
      .machine_sources span {
        display: block;
        font-family: monospace;
        font-size: 0.7rem;
        color: #62d66b;
        margin-bottom: 0.75rem;
      }
      strong {
        display: block;
        font-weight: 550;
        font-size: 0.95rem;
      }
      small {
        display: block;
        margin-top: 0.4rem;
        color: #a7b4ab;
        font-size: 0.75rem;
        line-height: 1.5;
      }
      .machine_connection {
        text-align: center;
        color: #62d66b;
        font-size: 1.75rem;
        padding: 0.45rem;
      }
      .machine_core {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem;
        border: 0.0625rem solid #62d66b;
        border-radius: 0.4rem;
        background: #62d66b0a;
      }
      .machine_core p {
        font-size: 0.8rem;
        color: #a7b4ab;
        margin-top: 0.25rem;
      }
      .machine_monogram {
        font-size: 2.25rem;
        letter-spacing: -0.12em;
        font-weight: 650;
        color: #62d66b;
        padding-right: 0.5rem;
      }
      .machine_chip {
        margin-left: auto;
        padding: 0.3rem 0.5rem;
        color: #62d66b;
        border: 0.0625rem solid #62d66b55;
        border-radius: 0.2rem;
        font-family: monospace;
        font-size: 0.65rem;
      }
      .machine_services {
        margin: 1.25rem 0 1.75rem;
      }
      .machine_services > div {
        border-left: 0.0625rem solid #546457;
        padding-left: 1rem;
      }
      .machine_edge {
        display: flex;
        gap: 1rem;
        padding-top: 1.25rem;
        border-top: 0.0625rem dashed #34443b;
        color: #a7b4ab;
        font-size: 0.75rem;
        line-height: 1.6;
      }
      .machine_edge > span {
        font-size: 1.5rem;
        color: #62d66b;
      }
      .machine_edge strong {
        font-size: inherit;
        color: #f2efe6;
      }
      @media (width < 30rem) {
        padding: 1rem;
        .machine_status {
          display: none;
        }
        .machine_sources {
          gap: 0.5rem;
        }
        .machine_sources > div {
          padding: 0.75rem;
        }
        .machine_chip {
          display: none;
        }
      }
    }
  }
</style>
