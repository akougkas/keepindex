---
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <div class="demo-live_wrap" id="demo">
      <div class="demo-live_container">
        {/* Omnibar Controls */}
        <div class="demo-live_omnibar">
          <div class="demo-live_bar_top">
            <div class="demo-live_modes" role="tablist" aria-label="Search Modes">
              <button
                class="demo-live_mode_btn is-active"
                role="tab"
                aria-selected="true"
                data-mode="ask"
                type="button"
              >
                <span class="demo-live_mode_icon">⚡</span>
                <span>Grounded Answer</span>
                <span class="demo-live_mode_badge">/api/ask</span>
              </button>
              <button
                class="demo-live_mode_btn"
                role="tab"
                aria-selected="false"
                data-mode="search"
                type="button"
              >
                <span class="demo-live_mode_icon">🔍</span>
                <span>Federated Search</span>
                <span class="demo-live_mode_badge">/api/search</span>
              </button>
              <button
                class="demo-live_mode_btn"
                role="tab"
                aria-selected="false"
                data-mode="research"
                type="button"
              >
                <span class="demo-live_mode_icon">🔬</span>
                <span>Deep Research</span>
                <span class="demo-live_mode_badge">/api/research</span>
              </button>
            </div>

            <div class="demo-live_target_filters">
              <span class="demo-live_target_label">Target:</span>
              <span class="demo-live_target_pill is-active" data-target="all">All Sources</span>
              <span class="demo-live_target_pill" data-target="web">Web</span>
              <span class="demo-live_target_pill" data-target="vault">Vault</span>
              <span class="demo-live_target_pill" data-target="docs">Docs</span>
              <span class="demo-live_target_pill" data-target="history">History</span>
            </div>
          </div>

          <div class="demo-live_search_box">
            <div class="demo-live_input_prefix">
              <span class="demo-live_dot" />
              <span class="demo-live_prompt_symbol">&gt;</span>
            </div>
            <input
              type="text"
              class="demo-live_input"
              value="How should I structure my reverse proxy for my homelab?"
              placeholder="Ask anything across web, vault, local docs, and history..."
              aria-label="Search query simulation"
            />
            <button class="demo-live_run_btn" type="button" aria-label="Execute search">
              Run Query ↵
            </button>
          </div>

          {/* Quick Query Presets */}
          <div class="demo-live_presets">
            <span class="demo-live_presets_title">Try real queries:</span>
            <button
              class="demo-live_preset_chip is-active"
              data-query="How should I structure my reverse proxy for my homelab?"
              type="button"
            >
              Homelab Reverse Proxy (Web + Vault + Config)
            </button>
            <button
              class="demo-live_preset_chip"
              data-query="BM25 ranking vs vector rerank in local SQLite"
              type="button"
            >
              BM25 vs Vector Rerank (Local Code + Paper)
            </button>
            <button
              class="demo-live_preset_chip"
              data-query="Compare zero-trust mesh options for a 3-node homelab"
              type="button"
            >
              Zero-Trust Mesh Comparison (Research mode)
            </button>
          </div>
        </div>

        {/* Live Workspace Area */}
        <div class="demo-live_workspace">
          {/* Query Vitals Bar */}
          <div class="demo-live_vitals">
            <div class="demo-live_vitals_item">
              <span class="demo-live_vital_label">INFERENCE:</span>
              <span class="demo-live_vital_val green">llama.cpp (Qwen2.5-7B) @ 127.0.0.1:8080</span>
            </div>
            <div class="demo-live_vitals_item">
              <span class="demo-live_vital_label">LATENCY:</span>
              <span class="demo-live_vital_val">1.18s (prefill 210 t/s)</span>
            </div>
            <div class="demo-live_vitals_item">
              <span class="demo-live_vital_label">GROUNDING COVERAGE:</span>
              <span class="demo-live_vital_val green" id="vital-coverage">96% (&ge; 80% REQUIRED)</span>
            </div>
            <div class="demo-live_vitals_item">
              <span class="demo-live_vital_label">PERSISTENCE:</span>
              <span class="demo-live_vital_val">SQLite WAL #d72f91a</span>
            </div>
          </div>

          {/* Mode 1: Grounded Answer View */}
          <div class="demo-live_view is-active" id="view-ask">
            <div class="demo-live_answer_card">
              <div class="demo-live_answer_header">
                <div class="demo-live_badge_row">
                  <span class="demo-live_status_badge verified" id="gate-status-badge">
                    ✓ GROUNDING GATE VERIFIED
                  </span>
                  <span class="demo-live_source_count">4 Sources Admitted</span>
                </div>
                <button class="demo-live_tamper_btn" id="btn-tamper" type="button">
                  <span>⚡ Test Hallucination Intercept</span>
                </button>
              </div>

              <div class="demo-live_answer_body" id="answer-content">
                <p>
                  To structure your homelab reverse proxy securely, terminate public ingress at the web edge via Cloudflare Tunnel or local Traefik <button class="demo-live_cite" data-cite="1">[1]</button>, and restrict host listeners to loopback (<code>127.0.0.1</code>) and internal Tailscale interfaces (<code>100.64.0.0/10</code>) <button class="demo-live_cite" data-cite="2">[2]</button>.
                </p>
                <p>
                  In Docker environments, place containers on an isolated bridge network (e.g., <code>web</code>) and route exclusively via dynamic Traefik container labels, preventing published port exposure to untrusted LAN segments <button class="demo-live_cite" data-cite="3">[3]</button>. Keep public and private services strictly compartmentalized, using separate host binds for internal dashboards like Portainer or SearXNG <button class="demo-live_cite" data-cite="4">[4]</button>.
                </p>
              </div>

              <div class="demo-live_tamper_notice" id="tamper-alert" hidden>
                <div class="demo-live_tamper_icon">🛑</div>
                <div class="demo-live_tamper_text">
                  <strong>FAIL-CLOSED GATE TRIGGERED: <code>status: no_evidence</code></strong>
                  <span>Sentence 2 introduced an out-of-pack assertion with no resolved local citation. Coverage dropped to 54% (below the 80% threshold). KeepIndex quarantined this response rather than presenting hallucinations as facts.</span>
                </div>
              </div>
            </div>

            {/* Evidence Pack Drawer / Cards */}
            <div class="demo-live_evidence_section">
              <div class="demo-live_evidence_heading">
                <span>ADMITTED EVIDENCE PACK (CLICK CITATION TO INSPECT)</span>
                <span class="demo-live_containment_badge">LOCAL BOUNDARY ENFORCED</span>
              </div>
              <div class="demo-live_evidence_grid">
                <div class="demo-live_evidence_card" data-source-id="1">
                  <div class="demo-live_evidence_header">
                    <span class="demo-live_cite_num">[1]</span>
                    <span class="demo-live_evidence_type web">SearXNG Web</span>
                    <span class="demo-live_evidence_host">doc.traefik.io</span>
                  </div>
                  <div class="demo-live_evidence_title">Traefik Docker Dynamic Routing &amp; Ingress</div>
                  <div class="demo-live_evidence_snippet">
                    "Traefik listens on Docker socket events to register dynamic HTTP routers. Containers on the shared network are discovered without publishing host ports."
                  </div>
                  <div class="demo-live_evidence_meta">BM25: 18.4 · Recency: 0.88 · Diversity rank: 1</div>
                </div>

                <div class="demo-live_evidence_card" data-source-id="2">
                  <div class="demo-live_evidence_header">
                    <span class="demo-live_cite_num">[2]</span>
                    <span class="demo-live_evidence_type vault">Obsidian Vault</span>
                    <span class="demo-live_evidence_host">vault/homelab/proxy.md</span>
                  </div>
                  <div class="demo-live_evidence_title">Homelab Network Topology &amp; Tailscale Ingress</div>
                  <div class="demo-live_evidence_snippet">
                    "Private admin dashboards must bind exclusively to Tailscale 100.64.0.0/10. Do not publish port 8080 or Portainer 9443 to the LAN gateway."
                  </div>
                  <div class="demo-live_evidence_meta">Tags: #homelab #networking #security · Wikilinks: 4</div>
                </div>

                <div class="demo-live_evidence_card" data-source-id="3">
                  <div class="demo-live_evidence_header">
                    <span class="demo-live_cite_num">[3]</span>
                    <span class="demo-live_evidence_type docs">Local Config</span>
                    <span class="demo-live_evidence_host">~/webhosting/infra/compose.yml</span>
                  </div>
                  <div class="demo-live_evidence_title">Traefik Gateway Compose &amp; UFW Rules</div>
                  <div class="demo-live_evidence_snippet">
                    "networks: web: external: true. Services attach with traefik.enable=true and traefik.http.routers.name.rule=Host(...) without exposed host ports."
                  </div>
                  <div class="demo-live_evidence_meta">Extracted text · Containment check: pass</div>
                </div>

                <div class="demo-live_evidence_card" data-source-id="4">
                  <div class="demo-live_evidence_header">
                    <span class="demo-live_cite_num">[4]</span>
                    <span class="demo-live_evidence_type history">Browser Memory</span>
                    <span class="demo-live_evidence_host">Firefox History</span>
                  </div>
                  <div class="demo-live_evidence_title">Cloudflare Zero Trust Tunnels Documentation</div>
                  <div class="demo-live_evidence_snippet">
                    "Visited 6 times · stripped OAuth fragments and query session keys · sanitized URL only: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/"
                  </div>
                  <div class="demo-live_evidence_meta">FTS5 match · Zero body retention</div>
                </div>
              </div>
            </div>
          </div>

          {/* Mode 2: Federated Search View */}
          <div class="demo-live_view" id="view-search">
            <div class="demo-live_search_results">
              <div class="demo-live_search_row">
                <span class="demo-live_source_indicator vault">Obsidian Vault</span>
                <div class="demo-live_search_info">
                  <a href="#demo" class="demo-live_search_title">BM25 Ranking and Lexical Scoring in SQLite FTS5</a>
                  <p class="demo-live_search_snippet">
                    Extracted from <code>vault/algorithms/information-retrieval.md</code>: Detailed notes on BM25 parameters k1=1.2, b=0.75 and how SQLite's matchinfo() / fts5 auxiliary functions calculate term frequency across document chunks.
                  </p>
                  <span class="demo-live_search_meta">Score: 0.94 · 1,420 words · Last indexed: 2 hours ago</span>
                </div>
              </div>

              <div class="demo-live_search_row">
                <span class="demo-live_source_indicator docs">Local Document (PDF)</span>
                <div class="demo-live_search_info">
                  <a href="#demo" class="demo-live_search_title">hybrid-search-rerank-systems.pdf (Page 4)</a>
                  <p class="demo-live_search_snippet">
                    Extracted via <code>pdftotext</code>: "Comparing reciprocal rank fusion against lexical BM25 baselines on memory-constrained devices shows that BM25 with local embedding reranking recovers 92% of full neural precision."
                  </p>
                  <span class="demo-live_search_meta">Score: 0.89 · PDF / Text · Containment verified</span>
                </div>
              </div>

              <div class="demo-live_search_row">
                <span class="demo-live_source_indicator web">SearXNG Web</span>
                <div class="demo-live_search_info">
                  <a href="#demo" class="demo-live_search_title">sqlite-vec: A vector search extension for SQLite</a>
                  <p class="demo-live_search_snippet">
                    Via local SearXNG meta-search: "sqlite-vec is an extremely fast vector search extension for SQLite, written in C. Zero external dependencies, pure local execution."
                  </p>
                  <span class="demo-live_search_meta">Score: 0.81 · Web hit via SearXNG @ 127.0.0.1:8888</span>
                </div>
              </div>

              <div class="demo-live_search_row">
                <span class="demo-live_source_indicator history">Private Browser History</span>
                <div class="demo-live_search_info">
                  <a href="#demo" class="demo-live_search_title">GitHub - asg017/sqlite-vec: Work-in-progress vector search SQLite extension</a>
                  <p class="demo-live_search_snippet">
                    Privately discovered in Chromium profile: Visited 14 times. Credential query params stripped before storage.
                  </p>
                  <span class="demo-live_search_meta">Score: 0.74 · Local FTS5 metadata</span>
                </div>
              </div>
            </div>
          </div>

          {/* Mode 3: Deep Research View */}
          <div class="demo-live_view" id="view-research">
            <div class="demo-live_research_layout">
              <div class="demo-live_research_steps">
                <div class="demo-live_rstep complete">
                  <span class="demo-live_rnum">01</span>
                  <div class="demo-live_rinfo">
                    <strong>Query Decomposition &amp; Planning</strong>
                    <span>Decomposed into 3 targeted sub-queries across local vault &amp; SearXNG</span>
                  </div>
                </div>
                <div class="demo-live_rstep complete">
                  <span class="demo-live_rnum">02</span>
                  <div class="demo-live_rinfo">
                    <strong>Evidence Lattice Assembly</strong>
                    <span>Retrieved 18 candidate chunks · 6 admitted to bounded evidence pack</span>
                  </div>
                </div>
                <div class="demo-live_rstep active">
                  <span class="demo-live_rnum">03</span>
                  <div class="demo-live_rinfo">
                    <strong>Recursive Synthesis &amp; Citation Gate</strong>
                    <span>Resolving claims against local evidence pack · Coverage checking</span>
                  </div>
                </div>
              </div>

              <div class="demo-live_research_synthesis">
                <div class="demo-live_research_header">
                  <strong>Deep Research Report: Zero-Trust Homelab Architecture</strong>
                  <span class="demo-live_tag">Synthesized locally</span>
                </div>
                <div class="demo-live_research_body">
                  <h4>1. WireGuard Mesh vs Tailscale Headscale</h4>
                  <p>
                    For a multi-node cluster, <strong>Tailscale</strong> offers zero-config NAT traversal via DERP relays while preserving end-to-end encryption. In homelabs requiring complete control without third-party authentication dependencies, self-hosted <strong>Headscale</strong> provides sovereign coordination.
                  </p>
                  <h4>2. Micro-Segmentation &amp; Container Ingress</h4>
                  <p>
                    Segregate ingress proxies from database and inference workers. Bind web hosting proxies (Traefik/Nginx) to port 80/443 on an external Docker network, and restrict database containers (PostgreSQL/VectorChord) to internal loopback networks.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}

<script>
  // Interactive Demo Script
  const root = document.getElementById("demo");
  if (root) {
    // Mode Switching
    const modeBtns = root.querySelectorAll<HTMLButtonElement>(".demo-live_mode_btn");
    const views = {
      ask: root.querySelector<HTMLElement>("#view-ask"),
      search: root.querySelector<HTMLElement>("#view-search"),
      research: root.querySelector<HTMLElement>("#view-research"),
    };

    modeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.dataset.mode as keyof typeof views;
        modeBtns.forEach((b) => {
          b.classList.remove("is-active");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("is-active");
        btn.setAttribute("aria-selected", "true");

        Object.values(views).forEach((v) => v?.classList.remove("is-active"));
        views[mode]?.classList.add("is-active");
      });
    });

    // Preset Queries
    const input = root.querySelector<HTMLInputElement>(".demo-live_input");
    const presetChips = root.querySelectorAll<HTMLButtonElement>(".demo-live_preset_chip");

    presetChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        presetChips.forEach((c) => c.classList.remove("is-active"));
        chip.classList.add("is-active");
        const query = chip.dataset.query;
        if (input && query) {
          input.value = query;
          if (query.includes("Zero-Trust")) {
            // Trigger research tab
            root.querySelector<HTMLButtonElement>('[data-mode="research"]')?.click();
          } else if (query.includes("BM25")) {
            root.querySelector<HTMLButtonElement>('[data-mode="search"]')?.click();
          } else {
            root.querySelector<HTMLButtonElement>('[data-mode="ask"]')?.click();
          }
        }
      });
    });

    // Citation Highlighting
    const citeBtns = root.querySelectorAll<HTMLButtonElement>(".demo-live_cite");
    const evidenceCards = root.querySelectorAll<HTMLElement>(".demo-live_evidence_card");

    citeBtns.forEach((cite) => {
      cite.addEventListener("click", () => {
        const id = cite.dataset.cite;
        evidenceCards.forEach((card) => {
          if (card.dataset.sourceId === id) {
            card.classList.add("highlighted");
            card.scrollIntoView({ behavior: "smooth", block: "nearest" });
          } else {
            card.classList.remove("highlighted");
          }
        });
      });
    });

    // Hallucination Tamper Test
    const tamperBtn = root.querySelector<HTMLButtonElement>("#btn-tamper");
    const answerContent = root.querySelector<HTMLElement>("#answer-content");
    const tamperAlert = root.querySelector<HTMLElement>("#tamper-alert");
    const gateBadge = root.querySelector<HTMLElement>("#gate-status-badge");
    const vitalCoverage = root.querySelector<HTMLElement>("#vital-coverage");

    let isTampered = false;

    tamperBtn?.addEventListener("click", () => {
      isTampered = !isTampered;
      if (isTampered) {
        tamperBtn.classList.add("active");
        tamperBtn.innerHTML = "<span>↩ Restore Verified Evidence</span>";
        if (answerContent) {
          answerContent.style.opacity = "0.35";
        }
        if (tamperAlert) tamperAlert.hidden = false;
        if (gateBadge) {
          gateBadge.className = "demo-live_status_badge rejected";
          gateBadge.textContent = "✕ REJECTED: COVERAGE 54% (FAIL-CLOSED)";
        }
        if (vitalCoverage) {
          vitalCoverage.className = "demo-live_vital_val red";
          vitalCoverage.textContent = "54% (FAILED GATE: NO_EVIDENCE)";
        }
      } else {
        tamperBtn.classList.remove("active");
        tamperBtn.innerHTML = "<span>⚡ Test Hallucination Intercept</span>";
        if (answerContent) {
          answerContent.style.opacity = "1";
        }
        if (tamperAlert) tamperAlert.hidden = true;
        if (gateBadge) {
          gateBadge.className = "demo-live_status_badge verified";
          gateBadge.textContent = "✓ GROUNDING GATE VERIFIED";
        }
        if (vitalCoverage) {
          vitalCoverage.className = "demo-live_vital_val green";
          vitalCoverage.textContent = "96% (≥ 80% REQUIRED)";
        }
      }
    });
  }
</script>

<style is:global>
  @layer components {
    .demo-live_wrap {
      width: 100%;
      margin-block: var(--space-6);
    }

    .demo-live_container {
      background-color: var(--dark-900);
      border: var(--border-width) solid color-mix(in lab, var(--brand-ivory) 16%, transparent);
      border-radius: var(--radius-main);
      overflow: hidden;
      box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.4);
    }

    /* Omnibar */
    .demo-live_omnibar {
      background-color: var(--dark-800);
      border-bottom: var(--border-width) solid color-mix(in lab, var(--brand-ivory) 12%, transparent);
      padding: var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .demo-live_bar_top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }

    .demo-live_modes {
      display: flex;
      gap: var(--space-2);
      background-color: var(--dark-900);
      padding: 0.25rem;
      border-radius: var(--radius-small);
      border: var(--border-width) solid color-mix(in lab, var(--brand-ivory) 10%, transparent);
    }

    .demo-live_mode_btn {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.4rem 0.75rem;
      border-radius: calc(var(--radius-small) - 0.125rem);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
      color: var(--brand-stone);
      transition: all var(--hover-duration) var(--hover-ease);
      border: 0;
      background: transparent;

      &.is-active {
        background-color: var(--dark-700);
        color: var(--brand-ivory);
        box-shadow: 0 0.125rem 0.375rem rgba(0, 0, 0, 0.3);
      }
      @media (hover: hover) {
        &:hover:not(.is-active) {
          color: var(--brand-ivory);
        }
      }
    }

    .demo-live_mode_icon {
      font-size: 0.9em;
    }

    .demo-live_mode_badge {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      background-color: color-mix(in lab, var(--brand-ivory) 8%, transparent);
      padding: 0.1rem 0.3rem;
      border-radius: 0.25rem;
      color: var(--brand-stone);
    }

    .demo-live_target_filters {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.75rem;
      font-family: var(--font-mono);
    }

    .demo-live_target_label {
      color: var(--brand-stone);
    }

    .demo-live_target_pill {
      padding: 0.2rem 0.5rem;
      border-radius: var(--radius-round);
      border: var(--border-width) solid color-mix(in lab, var(--brand-ivory) 12%, transparent);
      color: var(--brand-stone);
      cursor: pointer;
      transition: all 0.2s ease;

      &.is-active {
        border-color: var(--brand-green);
        color: var(--brand-green);
        background-color: color-mix(in lab, var(--brand-green) 10%, transparent);
      }
    }

    .demo-live_search_box {
      display: flex;
      align-items: center;
      background-color: var(--dark-900);
      border: var(--border-width) solid color-mix(in lab, var(--brand-ivory) 20%, transparent);
      border-radius: var(--radius-small);
      padding: 0.625rem 1rem;
      gap: 0.75rem;
      transition: border-color var(--hover-duration) var(--hover-ease);

      &:focus-within {
        border-color: var(--brand-green);
        box-shadow: 0 0 0 0.125rem color-mix(in lab, var(--brand-green) 25%, transparent);
      }
    }

    .demo-live_input_prefix {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .demo-live_dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      background-color: var(--brand-green);
      box-shadow: 0 0 0.5rem var(--brand-green);
    }

    .demo-live_prompt_symbol {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--brand-green);
    }

    .demo-live_input {
      flex: 1;
      background: transparent;
      border: 0;
      color: var(--brand-ivory);
      font-size: 1.05rem;
      font-family: var(--primary-family);
      outline: none;
    }

    .demo-live_run_btn {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      background-color: var(--brand-green);
      color: var(--brand-ink);
      padding: 0.4rem 0.8rem;
      border-radius: var(--radius-small);
      font-weight: 700;
      border: 0;
      transition: all var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          background-color: var(--brand-ivory);
        }
      }
    }

    .demo-live_presets {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
    }

    .demo-live_presets_title {
      font-size: 0.75rem;
      font-family: var(--font-mono);
      color: var(--brand-stone);
