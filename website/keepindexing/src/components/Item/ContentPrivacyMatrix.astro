---
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}
const { render = true } = Astro.props;
const rows = [
  [
    "Files & vaults",
    "Selected folders are indexed on this computer.",
    "Original files are read locally. Extracted text is stored in the local index.",
  ],
  [
    "Browser history",
    "Only the profiles you select are imported.",
    "URL, title, and visit metadata stay in the local index.",
  ],
  [
    "AI answers",
    "You choose the AI endpoint.",
    "Local runtimes keep inference here. Selected remote endpoints receive prompts and evidence excerpts.",
  ],
  [
    "Web search",
    "You choose whether to include the web.",
    "Search terms reach public engines. Fetched websites receive normal requests.",
  ],
  [
    "This website",
    "Product information and sample data only.",
    "Cloudflare and the web host process ordinary website requests; no connection to your private index.",
  ],
];
---

{
  render && (
    <div
      class="privacyflow_wrap"
      tabindex="0"
      role="region"
      aria-label="Where KeepIndex data goes"
    >
      <table>
        <>
          <caption>Know what stays here. Know what goes out.</caption>
          <thead>
            <tr>
              <>
                <th scope="col">Source</th>
                <th scope="col">Your control</th>
                <th scope="col">Data flow</th>
              </>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row">{row[0]}</th>
                <td>{row[1]}</td>
                <td>{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </>
      </table>
    </div>
  )
}
<style is:global>
  @layer components {
    .privacyflow_wrap {
      width: 100%;
      overflow-x: auto;
      table {
        width: 100%;
        min-width: 38rem;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.9rem;
        line-height: 1.6;
      }
      caption {
        text-align: left;
        font-size: 0.8rem;
        color: #a7a59b;
        padding-bottom: 1.25rem;
      }
      th,
      td {
        padding: 1.25rem 1rem;
        border-bottom: 0.0625rem solid #ffffff22;
        vertical-align: top;
      }
      thead th {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #62d66b;
      }
      tbody th {
        width: 20%;
        font-weight: 550;
      }
      td {
        color: #c2c6bb;
        width: 40%;
      }
    }
  }
</style>
