{
  "name": "keepindex",
  "private": true,
  "version": "1.0.0",
  "description": "Private, local-first federated search.",
  "license": "Apache-2.0",
  "homepage": "https://keepindex.ing",
  "repository": {
    "type": "git",
    "url": "https://github.com/akougkas/keepindex.git"
  },
  "bugs": {
    "url": "https://github.com/akougkas/keepindex/issues"
  },
  "keywords": [
    "local-first",
    "federated-search",
    "private-search",
    "pwa"
  ],
  "packageManager": "bun@1.3.10",
  "type": "module",
  "bin": {
    "keepidx": "./cli/keepidx.ts"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "start": "bun ./cli/keepidx.ts start",
    "keepidx": "bun ./cli/keepidx.ts",
    "typecheck": "tsc -b",
    "test": "bun test server src cli",
    "test:corpus": "bun scripts/run-correctness-corpus.ts",
    "profile:live": "bun scripts/profile-live-queries.ts",
    "test:e2e": "bash ./scripts/test-e2e.sh",
    "build": "tsc -b && vite build",
    "brand:generate": "bash ./scripts/generate-brand-assets.sh",
    "brand:check": "bun ./scripts/generate-brand-vectors.mjs --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "hono": "^4.11.9",
    "katex": "^0.16.28",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.25.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "fontkit": "^2.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
